rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // territories: 誰でも閲覧できるが(他ユーザーの領土を見る機能のため)、
    // 書き込みは匿名認証済みかつ自分のownerIdでのみ許可する。
    // 一度確定した領土は書き換え・削除しない(既存のローカル動作と同じ)。
    match /territories/{territoryId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }

    // territory_cheers: 応援スタンプ。ドキュメントIDが「送信先_送信元」で
    // 固定されているため、本人の送信分(fromOwnerId == 自分のuid)だけ
    // 書き込み(作成・上書き・取り消し)を許可すればよい。閲覧は誰でも可能
    // (件数を集計してランキング・チャレンジ画面に表示するため)。
    match /territory_cheers/{cheerId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.data.fromOwnerId == request.auth.uid;
    }
  }
}
